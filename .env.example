# Environment Configuration for ABONNEMENT.TN Bot

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=abonnement-tn

# Bot Configuration
BOT_NAME=ABONNEMENT.TN
BOT_LANGUAGE=ar-TN

# Response Delays (milliseconds)
MIN_RESPONSE_DELAY=2000
MAX_RESPONSE_DELAY=5000

# Working Hours (24h format)
WORKING_HOURS_START=8
WORKING_HOURS_END=23
